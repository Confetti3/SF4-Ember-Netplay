msgid "launcher.update_failed"
msgstr "Impossible d'installer la mise à jour. Fermez le jeu et l'ancien lanceur avant de réessayer. Voir %TEMP%\\sf4-netplay-update.log ; les copies conservées sont dans .ember-update-backups."

msgid "launcher.recovery_opened"
msgstr "Le réseau était indisponible : SF4 a été fermé pour la récupération. Relancer le jeu le redémarre ; le jeu hors ligne fonctionne sans réseau."

msgid "launcher.path_failed"
msgstr "Impossible de configurer le chemin de recherche. Extrayez le paquet complet dans un dossier accessible en écriture."

msgid "launcher.game_not_found"
