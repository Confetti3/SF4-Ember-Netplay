msgid "launcher.recovery_opened"
msgstr "La red no estaba disponible, así que SF4 se cerró para la recuperación. Reintentar lo abre de nuevo; el juego sin conexión funciona sin red."

msgid "launcher.path_failed"
msgstr "No se pudo configurar la ruta de búsqueda de bibliotecas. Extrae el paquete completo en una carpeta con permisos de escritura."

msgid "launcher.game_not_found"
