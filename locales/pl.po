msgid "launcher.update_failed"
msgstr "Nie udało się zainstalować aktualizacji. Zamknij grę i poprzedni launcher, a potem spróbuj ponownie. Szczegóły: %TEMP%\\sf4-netplay-update.log; kopie zapasowe produktu są w .ember-update-backups."

msgid "launcher.recovery_opened"
