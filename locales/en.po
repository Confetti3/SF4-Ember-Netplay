msgid "launcher.update_failed"
msgstr "The update could not be installed. Close the game and previous launcher before retrying. See %TEMP%\\sf4-netplay-update.log; preserved product copies are in .ember-update-backups."

msgid "launcher.recovery_opened"
msgstr "Networking was unavailable, so SF4 closed for recovery. Retry launch starts it again; offline play works without networking."

msgid "launcher.path_failed"
msgstr "The runtime search path could not be configured. Extract the complete package to a writable folder."

msgid "launcher.game_not_found"
msgstr "Ultra Street Fighter IV could not be found."

msgid "launcher.sidecar_missing"
msgstr "Sidecar.dll is missing or its path cannot be used by the injector. Extract the full package to a simple local path."

msgid "launcher.runtime_outdated"
msgstr "Your Microsoft Visual C++ runtime is out of date, and the game would crash on start. Install the latest Visual C++ Redistributable (x86), then start Ember again.\n\nOpen the download page now?"

msgid "launcher.already_running"
msgstr "SF4 Ember Netplay is already running. If you cannot see it, end Launcher.exe and SSFIV.exe in Task Manager, then start Ember again."

msgid "launcher.start_failed"
msgstr "Game startup or injection failed. Check the launcher log at %APPDATA%\\sf4e\\logs\\launcher.log, then retry."

msgid "launcher.game_runs_as_admin"
msgstr "SSFIV.exe is set to run as administrator, so Ember cannot start it. Right-click SSFIV.exe in the game folder, open Properties, then Compatibility, and clear \"Run this program as an administrator\", also under \"Change settings for all users\". Then retry."

msgid "launcher.game_error"
msgstr "The game exited with an error. Inspect the launcher log at %APPDATA%\\sf4e\\logs\\launcher.log, then retry."

msgid "launcher.steam_runs_as_admin"
msgstr "The game could not reach Steam because Steam is running as administrator. Close Steam, start it again normally, then retry. Starting Ember as administrator also works, but updates will not install that way."

msgid "launcher.game_crashed"
msgstr "The game crashed. To help fix it, choose Send this report below. Or send the files in %APPDATA%\\sf4e\\logs yourself."

msgid "launcher.runtime_shadowed"
msgstr "The game would load these files instead of the ones in the Ember folder, and an old copy stops the game before it starts (\"entry point ggpo_get_last_confirmed_frame not found\"). They were left by another netplay mod or an older install. Move or rename them, then start Ember again:\n\n{0}"

msgid "launcher.game_wrong_dll"
msgstr "The game stopped before Ember could start because a DLL it loaded is missing a function. That usually means a GGPO.dll, spdlog.dll, fmt.dll or zlib1.dll from another mod or an older install is next to SSFIV.exe. Move any you find away, then retry. If none is there, send the launcher log at %APPDATA%\\sf4e\\logs\\launcher.log."

msgid "launcher.game_blocked_by_windows"
msgstr "Windows blocked one of the game's files before Ember could start (application control). Smart App Control cannot allow a single program: if it is on in Windows Security, Ember can run only once it is turned off. On a PC an organization manages, ask its administrator to allow Ember."

