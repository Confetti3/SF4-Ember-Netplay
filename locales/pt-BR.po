msgid "launcher.recovery_opened"
msgstr "A rede estava indisponível, então o SF4 foi fechado para recuperação. Tentar iniciar novamente inicia o jogo de novo; o jogo offline funciona sem rede."

msgid "launcher.path_failed"
msgstr "Não foi possível configurar o caminho de busca do runtime. Extraia o pacote completo em uma pasta gravável."

