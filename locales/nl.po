msgid "launcher.update_failed"
msgstr "De update kon niet worden geïnstalleerd. Sluit het spel en de vorige launcher en probeer het opnieuw. Zie %TEMP%\\sf4-netplay-update.log; bewaarde productkopieën staan in .ember-update-backups."

msgid "launcher.recovery_opened"
msgstr "Het netwerk was niet beschikbaar, dus SF4 is gesloten voor herstel. Opnieuw starten start het weer; offline spelen werkt zonder netwerk."

