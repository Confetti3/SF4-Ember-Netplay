msgid "launcher.already_running"
msgstr "SF4 Ember Netplay가 이미 실행 중입니다. 창이 보이지 않으면 작업 관리자에서 Launcher.exe와 SSFIV.exe를 종료한 뒤 Ember를 다시 시작하세요."

msgid "launcher.start_failed"
