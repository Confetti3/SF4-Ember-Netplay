# Shell entry points must run from Windows checkouts, archives and containers.
*.sh text eol=lf
*.desktop text eol=lf
# Everything Linux reads from the deploy and container directories must stay LF
# in every checkout: setup.sh matches unit lines with a trailing "$".
*.service text eol=lf
*.timer text eol=lf
server/**/deploy/** text eol=lf
server/*/docker/** text eol=lf
# Vendored crates stay byte-for-byte as published (rust/vendor/README.md).
rust/vendor/** -text
# The Linux build PC's cross build reads these as they are (a port's patch applies to LF sources).
cmake/cross/** text eol=lf
