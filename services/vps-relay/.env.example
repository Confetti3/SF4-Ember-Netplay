# Relay manager (localhost only; broker calls this service)
RELAY_MANAGER_PORT=8788
RELAY_MANAGER_BIND=127.0.0.1
# Optional shared secret — set the same value on the room broker as RELAY_MANAGER_TOKEN
# RELAY_MANAGER_TOKEN=
# Port allowlists (must match broker RELAY_PORT_BASE / GGPO_UDP_PORT_BASE + MAX_ROOMS)
SESSION_PORT_MIN=23456
SESSION_PORT_MAX=23505
GGPO_PORT_MIN=24456
GGPO_PORT_MAX=24505
# SF4E_SESSION_RELAY_BIN=/path/to/sf4e-session-relay
# SF4E_GGPO_UDP_RELAY_BIN=/path/to/sf4e-ggpo-udp-relay
RELAY_IDENTITY=relay-vps
