cmake_minimum_required(VERSION 3.26)
# The build, CI matrix, advisory scanner and quality runner share this list.
# Compare it to independent workspace manifests so a new service cannot vanish.
if(NOT DEFINED SF4E_WORKSPACE_ROOT)
    set(SF4E_WORKSPACE_ROOT "${CMAKE_SOURCE_DIR}")
endif()
file(READ "${SF4E_WORKSPACE_ROOT}/scripts/rust-workspaces.json" SF4E_RUST_WORKSPACES)
string(JSON workspace_count LENGTH "${SF4E_RUST_WORKSPACES}")
if(workspace_count LESS 1)
    message(FATAL_ERROR "Rust workspace inventory is empty")
endif()
math(EXPR SF4E_RUST_WORKSPACE_LAST "${workspace_count}-1")
set(expected_manifests)
set(workspace_tests)
foreach(index RANGE ${SF4E_RUST_WORKSPACE_LAST})
    string(JSON workspace GET "${SF4E_RUST_WORKSPACES}" ${index} path)
    string(JSON test_name GET "${SF4E_RUST_WORKSPACES}" ${index} test)
    if(test_name IN_LIST workspace_tests OR NOT EXISTS "${SF4E_WORKSPACE_ROOT}/${workspace}/Cargo.lock")
        message(FATAL_ERROR "Duplicate test or missing lockfile for ${workspace}")
    endif()
    list(APPEND workspace_tests "${test_name}")
    list(APPEND expected_manifests "${workspace}/Cargo.toml")
endforeach()
file(GLOB actual_manifests RELATIVE "${SF4E_WORKSPACE_ROOT}"
    "${SF4E_WORKSPACE_ROOT}/rust/*/Cargo.toml" "${SF4E_WORKSPACE_ROOT}/server/*/Cargo.toml")
list(SORT expected_manifests)
list(SORT actual_manifests)
if(NOT "${expected_manifests}" STREQUAL "${actual_manifests}")
    message(FATAL_ERROR "Rust workspace inventory differs from repository manifests. Expected: ${actual_manifests}; listed: ${expected_manifests}")
endif()
