+/*
+ * The configuration lookups read environment variables, and Log is called
+ * several times per packet and once per poll. Read them once per process so
+ * a disabled log costs a branch, not a formatting pass and two lookups.
+ */
+bool LogEnabled()
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      enabled = (Platform::GetConfigBool("ggpo.log") && !Platform::GetConfigBool("ggpo.log.ignore")) ? 1 : 0;
+   }
+   return enabled == 1;
+}
