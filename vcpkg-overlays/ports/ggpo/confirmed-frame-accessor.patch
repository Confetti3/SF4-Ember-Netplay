+/*
+ * Read-only, game-thread accessor for the last confirmed INPUT frame.
+ * Returns -1 until input is confirmed. State saved as frame N contains
+ * inputs through N-1. Unsupported backends return UNSUPPORTED, not an
+ * estimated frame. This call does not poll, advance, or change pacing.
+ */
+GGPO_API GGPOErrorCode __cdecl ggpo_get_last_confirmed_frame(GGPOSession *,
+                                                           int *frame);
+
