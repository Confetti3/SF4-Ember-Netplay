+GGPOErrorCode
+ggpo_get_last_confirmed_frame(GGPOSession *ggpo, int *frame)
+{
+   if (!ggpo) { return GGPO_ERRORCODE_INVALID_SESSION; }
+   if (!frame) { return GGPO_ERRORCODE_INVALID_REQUEST; }
+   *frame = -1;
+   return ggpo->GetLastConfirmedFrame(frame);
+}
