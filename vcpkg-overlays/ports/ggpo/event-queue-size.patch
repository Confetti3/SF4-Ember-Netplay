diff --git a/src/lib/ggpo/network/udp_proto.h b/src/lib/ggpo/network/udp_proto.h
index 4bf6374..9b7097a 100644
--- a/src/lib/ggpo/network/udp_proto.h
+++ b/src/lib/ggpo/network/udp_proto.h
@@ -17,6 +17,16 @@
 #include "ring_buffer.h"
 #include "input-repair.h"
 
+/*
+ * One input packet carries at most the sender's whole pending output
+ * (PENDING_OUTPUT_SIZE - 1 frames), so the event queue holds a full window of
+ * inputs plus the control events one poll can add: at most 7 while syncing
+ * (Connected, up to 4 Synchronizing, Synchronized, Disconnected) and 3 when
+ * running (NetworkInterrupted, NetworkResumed, Disconnected).
+ */
+#define PENDING_OUTPUT_SIZE      64
+#define EVENT_QUEUE_SIZE         (PENDING_OUTPUT_SIZE + 8)
+
 class UdpProtocol : public IPollSink
 {
 public:
@@ -181,7 +191,7 @@ protected:
    /*
     * Packet loss...
     */
-   RingBuffer<GameInput, 64>  _pending_output;
+   RingBuffer<GameInput, PENDING_OUTPUT_SIZE>  _pending_output;
    GameInput                  _last_received_input;
    GameInput                  _last_sent_input;
    GameInput                  _last_acked_input;
@@ -211,7 +221,7 @@ protected:
    /*
     * Event queue
     */
-   RingBuffer<UdpProtocol::Event, 64>  _event_queue;
+   RingBuffer<UdpProtocol::Event, EVENT_QUEUE_SIZE>  _event_queue;
 };
 
 #endif
