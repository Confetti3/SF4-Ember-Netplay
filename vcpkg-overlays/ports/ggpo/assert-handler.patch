+/*
+ * ggpo_set_assert_handler --
+ *
+ * Called with the assertion text when a GGPO assertion fails, before the
+ * process exits. Without a handler the Windows build shows a message box.
+ * The host uses it to write its own crash record.
+ */
+typedef void (__cdecl *GGPOAssertHandler)(const char *message);
+
+GGPO_API void __cdecl ggpo_set_assert_handler(GGPOAssertHandler handler);
+
 #ifdef __cplusplus
 };
 #endif
