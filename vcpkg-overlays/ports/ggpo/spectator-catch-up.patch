+GGPOErrorCode
+ggpo_get_spectator_backlog(GGPOSession *ggpo, int *frames)
+{
+   if (!ggpo) { return GGPO_ERRORCODE_INVALID_SESSION; }
+   if (!frames) { return GGPO_ERRORCODE_INVALID_REQUEST; }
+   *frames = 0;
+   return ggpo->GetSpectatorBacklog(frames);
+}
