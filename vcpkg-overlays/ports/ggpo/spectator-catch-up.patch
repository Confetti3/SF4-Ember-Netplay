 GGPOErrorCode
+SpectatorBackend::GetSpectatorBacklog(int *frames)
+{
+   const int backlog = _last_received_frame - _next_input_to_send + 1;
+   *frames = backlog > 0 ? backlog : 0;
+   return GGPO_OK;
+}
