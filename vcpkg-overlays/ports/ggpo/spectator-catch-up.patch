+      if (input.frame >= _next_input_to_send + SPECTATOR_FRAME_BUFFER_SIZE) {
+         // This slot still holds an unplayed frame; SyncInput reports the loss.
+         Log("Spectator backlog overflow: frame %d arrived while frame %d is unplayed.\n",
+             input.frame, _next_input_to_send);
+      }
       _inputs[input.frame % SPECTATOR_FRAME_BUFFER_SIZE] = input;
