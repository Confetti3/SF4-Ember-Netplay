-#define SPECTATOR_FRAME_BUFFER_SIZE    64
+/*
+ * The host streams confirmed frames as fast as the fighters confirm them and
+ * never waits for a spectator, so this ring is the spectator's whole backlog.
+ * At 64 frames (about one second) any accumulated slowdown overwrote a frame
+ * before it was played, which is unrecoverable. 1024 frames is about 17 s.
+ */
+#define SPECTATOR_FRAME_BUFFER_SIZE    1024
 
