diff --git a/src/lib/ggpo/input_queue.h b/src/lib/ggpo/input_queue.h
index 460a501..7cf20a0 100644
--- a/src/lib/ggpo/input_queue.h
+++ b/src/lib/ggpo/input_queue.h
@@ -13,6 +13,20 @@
 #define INPUT_QUEUE_LENGTH    128
 #define DEFAULT_INPUT_SIZE      4
 
+/*
+ * Frames whose inputs the game ignores (ggpo_set_inputs_ignored): an input
+ * for such a frame that differs from its prediction is not a misprediction,
+ * so no rollback starts there.  Kept for as many frames as an input queue.
+ */
+struct IgnoredFrames {
+   struct Entry { int frame; bool ignored; };
+   Entry entries[INPUT_QUEUE_LENGTH];
+
+   IgnoredFrames() { for (int i = 0; i < INPUT_QUEUE_LENGTH; i++) { entries[i].frame = GameInput::NullFrame; entries[i].ignored = false; } }
+   void Mark(int frame, bool ignored) { Entry &e = entries[frame % INPUT_QUEUE_LENGTH]; e.frame = frame; e.ignored = ignored; }
+   bool Ignored(int frame) const { const Entry &e = entries[frame % INPUT_QUEUE_LENGTH]; return e.frame == frame && e.ignored; }
+};
+
 class InputQueue {
 public:
    InputQueue(int input_size = DEFAULT_INPUT_SIZE);
@@ -30,6 +44,7 @@ public:
    bool GetConfirmedInput(int frame, GameInput *input);
    bool GetInput(int frame, GameInput *input);
    void AddInput(GameInput &input);
+   void SetIgnoredFrames(const IgnoredFrames *ignored) { _ignored = ignored; }
 
 protected:
    int AdvanceQueueHead(int frame);
@@ -52,6 +67,7 @@ protected:
 
    GameInput            _inputs[INPUT_QUEUE_LENGTH];
    GameInput            _prediction;
+   const IgnoredFrames  *_ignored = nullptr;
 };
 
 #endif
