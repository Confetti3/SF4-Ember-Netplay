+/*
+ * ggpo_set_inputs_ignored --
+ *
+ * Says whether the game reads the inputs of the frame it is about to
+ * advance (call it after ggpo_synchronize_input, before ggpo_advance_frame,
+ * also inside advance_frame callbacks).  When ignored, an input for that
+ * frame that differs from its prediction does not count as a misprediction,
+ * so no rollback starts on it.  The game must then not let those inputs
+ * change the simulation.
+ */
+GGPO_API GGPOErrorCode __cdecl ggpo_set_inputs_ignored(GGPOSession *,
+                                                      bool ignored);
