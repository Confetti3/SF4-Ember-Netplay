@@ -369,12 +370,27 @@ UdpProtocol::Disconnect()
    _shutdown_timeout = Platform::GetCurrentTimeMS() + UDP_SHUTDOWN_TIMER;
 }
 
+/*
+ * Each round of the handshake has its own challenge, never the previous
+ * round's, so a late duplicate reply to that round cannot be taken for this one.
+ */
+void
+UdpProtocol::StartSyncRound()
+{
+   uint32 random;
+   do {
+      random = rand() & 0xFFFF;
+   } while (random == _state.sync.random);
+   _state.sync.random = random;
+   SendSyncRequest();
+}
+
 void
 UdpProtocol::SendSyncRequest()
 {
-   _state.sync.random = rand() & 0xFFFF;
    UdpMsg *msg = new UdpMsg(UdpMsg::SyncRequest);
    msg->u.sync_request.random_request = _state.sync.random;
+   _last_sync_request_time = Platform::GetCurrentTimeMS();
    SendMsg(msg);
 }
 
@@ -499,7 +515,7 @@ UdpProtocol::Synchronize()
    if (_udp) {
       _current_state = Syncing;
       _state.sync.roundtrips_remaining = NUM_SYNC_PACKETS;
-      SendSyncRequest();
+      StartSyncRound();
    }
 }
 
@@ -623,7 +639,7 @@ UdpProtocol::OnSyncReply(UdpMsg *msg, int len)
       evt.u.synchronizing.total = NUM_SYNC_PACKETS;
       evt.u.synchronizing.count = NUM_SYNC_PACKETS - _state.sync.roundtrips_remaining;
       QueueEvent(evt);
-      SendSyncRequest();
+      StartSyncRound();
    }
    return true;
 }
