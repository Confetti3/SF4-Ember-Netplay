+/*
+ * The receive boundary for input: nothing in an input packet is applied until
+ * all of it is known to fit this session, whatever the packet declares.
+ *  - width: every frame is the session's input size (Init);
+ *  - encoding: every read stays inside the declared bits and every button
+ *    inside the input (input-bits.h), which also counts the frames;
+ *  - frame count: at most an honest sender's whole pending output
+ *    (PENDING_OUTPUT_SIZE - 1 frames), numbered as non-negative ints;
+ *  - continuity: the frames continue the stream without a gap.  A sender that
+ *    skipped frames we never received (it stopped queueing for us when its
+ *    pending output filled) cannot resume the stream;
+ *  - capacity: the new frames fit in the event queue within that same window,
+ *    counting what every packet read since the backend last drained it queued
+ *    (see EVENT_QUEUE_SIZE).
+ * An honest peer never fails these, so a packet that does is not consumed and
+ * ends the stream like a receive timeout.
+ */
+bool
+UdpProtocol::AcceptsInput(UdpMsg *msg)
+{
+   if (!msg->u.input.num_bits) {
+      return true;
+   }
+   if (msg->u.input.input_size != _input_size) {
+      Log("input size %d is not this session's %d.\n", (int)msg->u.input.input_size, _input_size);
+      return false;
+   }
+   const int frames = sf4e::netplay::InputBitsFrames(msg->u.input.bits, msg->u.input.num_bits, (int)sizeof(msg->u.input.bits),
+                                                     _input_size, (int)sizeof(_last_received_input.bits));
+   if (frames < 0) {
+      Log("input has an invalid encoding (bits:%d).\n", (int)msg->u.input.num_bits);
+      return false;
+   }
+   if (frames > PENDING_OUTPUT_SIZE - 1 || msg->u.input.start_frame > (uint32)(INT_MAX - frames)) {
+      Log("input holds %d frames from frame %u.\n", frames, msg->u.input.start_frame);
+      return false;
+   }
+   const int first = (int)msg->u.input.start_frame;
+   const int expected = _last_received_input.frame < 0 ? first : _last_received_input.frame + 1;
+   if (first > expected) {
+      Log("Input gap (got frame %d, expected %d).\n", first, expected);
+      return false;
+   }
+   const int new_frames = MAX(first + frames - expected, 0);
+   if (_event_queue.size() + new_frames > PENDING_OUTPUT_SIZE - 1) {
+      Log("%d new input frames do not fit beside %d queued events.\n", new_frames, _event_queue.size());
+      return false;
+   }
+   return true;
+}
