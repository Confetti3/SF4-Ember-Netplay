+/*
+ * A session whose socket could not bind never works: it is deleted, and the
+ * Winsock error is left for WSAGetLastError.
+ */
+static GGPOErrorCode
+CheckSocket(GGPOSession **session)
+{
+   int error = (*session)->BindError();
+   if (!error) {
+      return GGPO_OK;
+   }
+   delete *session;
+   *session = NULL;
+   WSASetLastError(error);
+   return GGPO_ERRORCODE_GENERAL_FAILURE;
+}
