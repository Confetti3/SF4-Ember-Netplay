[Unit]
Description=Ember public room supervisor
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/lib/ember-rooms/ember-rooms /etc/ember-rooms/config.json
# SIGHUP re-reads config.json: max_rooms, port_range and builds change while
# rooms keep running (setup.sh reloads instead of restarting when the
# supervisor binary is unchanged). The other settings need a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
User=ember-rooms
Group=ember-rooms

# Helper state and logs. The supervisor starts every room host here and
# gives the host a HOME it can write to.
StateDirectory=ember-rooms
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ember-rooms
Environment=HOME=/var/lib/ember-rooms
# The room hosts and helpers inherit this. glibc gives every thread its own
# malloc arena and keeps each one at its peak, so a helper that copies a
# 320 KiB checkpoint on a few threads holds several times that for good; two
# arenas keep that retention small. Set in the container image too.
Environment=MALLOC_ARENA_MAX=2
UMask=0077

# SIGTERM starts a drain: no new rooms, existing ones run until empty or
# drain_secs (600 in config.json). The stop timeout must stay above
# drain_secs plus the 10 s the supervisor gives a host to exit, so a restart
# waits for the drain instead of killing rooms. Raise both together.
TimeoutStopSec=660
# Only the supervisor gets the SIGTERM, so it can drain; the room hosts keep
# running until it closes them. If the unit is still up at TimeoutStopSec,
# SIGKILL goes to everything left in the cgroup, so no room host outlives the
# supervisor. (control-group would send the SIGTERM to every room host at
# once and defeat the drain.)
KillMode=mixed
# If the kernel kills one room host for memory, keep the other rooms: the
# supervisor reaps the dead child and removes only that room.
OOMPolicy=continue

# Room hosts open UDP sockets to the Internet (iroh QUIC, relays over HTTPS,
# DNS), so there is no address filter and no system call filter. The
# supervisor starts two processes per room, so process spawning must work.
# AF_NETLINK is for the network interface watcher in the helper.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

# The box has 3.8 GB and a 2 GB swapfile, and also runs the bridge and the
# short-link service (about 45 MB in use together, capped at 352 MB); the
# system itself takes about 430 MB. This limit covers the supervisor and every
# room together. With 20 busy rooms on 2026-10-06 the rooms took 1134 MB, about
# 57 MB each, but a helper grows with the room's age (the oldest held 108 MB),
# so a room is budgeted at 100 MB: 3000M holds max_rooms 30.
MemoryMax=3000M
# Past the limit the rooms may use up to 1 GB of swap rather than have a room
# host stopped mid-match. Swapped rooms stall, so this is overflow only: keep
# MemoryMax above max_rooms times 100M.
MemorySwapMax=1G
# A room measured about 8 tasks (room host plus helper threads), so 512
# leaves plenty of headroom; setup.sh warns when the config asks for more.
TasksMax=512

[Install]
WantedBy=multi-user.target
