[Unit]
Description=Ember public room supervisor
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/lib/ember-rooms/ember-rooms /etc/ember-rooms/config.json
# SIGHUP re-reads config.json: max_rooms, port_range and builds change while
# rooms keep running (setup.sh reloads instead of restarting when the
# supervisor binary is unchanged). The other settings need a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
User=ember-rooms
Group=ember-rooms

# Helper state and logs. The supervisor starts every room host here and
# gives the host a HOME it can write to.
StateDirectory=ember-rooms
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ember-rooms
Environment=HOME=/var/lib/ember-rooms
# The room hosts and helpers inherit this. glibc keeps freed blocks at their
# peak and raises its mmap threshold to the largest block freed, so each
# member that joined a room left about 9 MB held in its helper for good (a
# room rejoined ten times held 55 MB, 15 MB with these). Room host and helper
# builds from 2026-11 set the same with mallopt; this covers the older builds
# the supervisor still runs. Set in the container image too.
Environment=MALLOC_ARENA_MAX=1 MALLOC_MMAP_THRESHOLD_=131072 MALLOC_TRIM_THRESHOLD_=131072
UMask=0077

# SIGTERM starts a drain: no new rooms, existing ones run until empty or
# drain_secs (600 in config.json). The stop timeout must stay above
# drain_secs plus the 10 s the supervisor gives a host to exit, so a restart
# waits for the drain instead of killing rooms. Raise both together.
TimeoutStopSec=660
# Only the supervisor gets the SIGTERM, so it can drain; the room hosts keep
# running until it closes them. If the unit is still up at TimeoutStopSec,
# SIGKILL goes to everything left in the cgroup, so no room host outlives the
# supervisor. (control-group would send the SIGTERM to every room host at
# once and defeat the drain.)
KillMode=mixed
# If the kernel kills one room host for memory, keep the other rooms: the
# supervisor reaps the dead child and removes only that room.
OOMPolicy=continue

# Room hosts open UDP sockets to the Internet (iroh QUIC, relays over HTTPS,
# DNS), so there is no address filter and no system call filter. The
# supervisor starts two processes per room, so process spawning must work.
# AF_NETLINK is for the network interface watcher in the helper.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

# The box has 7.7 GB, 4 vCPUs and a 2 GB swapfile, and also runs the bridge
# and the short-link service (about 45 MB in use together, capped at 352 MB);
# the system itself takes about 430 MB. This limit covers the supervisor and
# every room together. Rooms used to grow with every member who joined (73 MB
# each at 30 rooms on 2026-10-07, the oldest 108 MB); with the allocator
# settings above a room of 4 members held about 29 MB after ten rejoins
# (2026-10-31, docs/development/PUBLIC_ROOM_CAPACITY_2026-10-31.md), so a room
# is budgeted at 40 MB: 4500M holds max_rooms 100 with headroom.
MemoryMax=4500M
# Past the limit the rooms may use up to 1 GB of swap rather than have a room
# host stopped mid-match. Swapped rooms stall, so this is overflow only: keep
# MemoryMax above max_rooms times 40M.
MemorySwapMax=1G
# A room measured about 8 tasks (room host plus helper threads); setup.sh
# warns below 16 per room, so 2048 covers max_rooms 100 with headroom.
TasksMax=2048

[Install]
WantedBy=multi-user.target
