{
  "id": "challonge",
  "display_name": "Challonge",
  "client_id": "your-challonge-client-id",
  "scope": "me",
  "authorize_url": "https://api.challonge.com/oauth/authorize",
  "token_url": "https://api.challonge.com/oauth/token",
  "token_encoding": "form",
  "user": {
    "method": "GET",
    "url": "https://api.challonge.com/v2.1/me.json",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/vnd.api+json",
      "Authorization-Type": "v2"
    },
    "id_pointer": "/data/id",
    "username_pointer": "/data/attributes/username"
  },
  "username_rule": {
    "characters": "letters_digits",
    "also": "_-.",
    "max_length": 64,
    "case_insensitive": true
  },
  "lookup_by": "username",
  "hosts": ["api.challonge.com"],
  "limits": {
    "monthly_request_budget": 400,
    "daily_request_budget": 40,
    "starts_per_hour": 30
  },
  "organizer": {
    "scope": "me tournaments:read tournaments:write matches:read matches:write participants:read participants:write",
    "tournaments": {
      "method": "GET",
      "url": "https://api.challonge.com/v2.1/tournaments.json?per_page=50",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/vnd.api+json",
        "Authorization-Type": "v2"
      },
      "list_pointer": "/data",
      "id_pointer": "/id",
      "name_pointer": "/attributes/name"
    },
    "create": {
      "url": "https://api.challonge.com/v2.1/tournaments.json",
      "delete_url": "https://api.challonge.com/v2.1/tournaments/{tournament}.json",
      "start_url": "https://api.challonge.com/v2.1/tournaments/{tournament}/change_state.json",
      "start_body": { "data": { "type": "TournamentState", "attributes": { "state": "start" } } },
      "reset_body": { "data": { "type": "TournamentState", "attributes": { "state": "reset" } } },
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/vnd.api+json",
        "Authorization-Type": "v2"
      },
      "body": {
        "data": {
          "type": "tournaments",
          "attributes": {
            "name": "",
            "tournament_type": "double elimination",
            "game_name": "Ultra Street Fighter IV",
            "registration_options": {},
            "double_elimination_options": {},
            "match_options": {},
            "round_robin_options": {},
            "swiss_options": {}
          }
        }
      },
      "name_pointer": "/data/attributes/name",
      "fields": {
        "format": {
          "pointer": "/data/attributes/tournament_type",
          "values": ["single elimination", "double elimination", "round robin", "swiss"],
          "with": {
            "round robin": {
              "/data/attributes/round_robin_options": {
                "iterations": 1, "ranking": "custom", "pts_for_game_win": "0.0", "pts_for_game_tie": "0.0",
                "pts_for_match_win": "1.0", "pts_for_match_tie": "0.5"
              }
            },
            "swiss": {
              "/data/attributes/swiss_options": {
                "rounds": 3, "pts_for_bye": "1.0", "pts_for_game_win": "0.0", "pts_for_game_tie": "0.0",
                "pts_for_match_win": "1.0", "pts_for_match_tie": "0.5"
              }
            }
          }
        },
        "round_robin_match_tie": {
          "pointer": "/data/attributes/round_robin_options/pts_for_match_tie",
          "values": ["0.0", "0.5", "1.0"]
        },
        "swiss_match_tie": {
          "pointer": "/data/attributes/swiss_options/pts_for_match_tie",
          "values": ["0.0", "0.5", "1.0"]
        },
        "grand_final": {
          "pointer": "/data/attributes/double_elimination_options/grand_finals_modifier",
          "values": ["", "single match", "skip"]
        },
        "third_place_match": {
          "pointer": "/data/attributes/match_options/consolation_matches_target_rank",
          "values": [3]
        },
        "open_signup": {
          "pointer": "/data/attributes/registration_options/open_signup",
          "values": [true, false]
        }
      },
      "id_pointer": "/data/id",
      "link_pointer": "/data/attributes/url",
      "link_prefix": "https://challonge.com/"
    },
    "participants": {
      "url": "https://api.challonge.com/v2.1/tournaments/{tournament}/participants.json",
      "remove_url": "https://api.challonge.com/v2.1/tournaments/{tournament}/participants/{participant}.json",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/vnd.api+json",
        "Authorization-Type": "v2"
      },
      "body": { "data": { "type": "participant", "attributes": { "name": "", "username": "", "misc": "" } } },
      "name_pointer": "/data/attributes/name",
      "username_pointer": "/data/attributes/username",
      "marker_pointer": "/data/attributes/misc",
      "id_pointer": "/data/id"
    }
  }
}
