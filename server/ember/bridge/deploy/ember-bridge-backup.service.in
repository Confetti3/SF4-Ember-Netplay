[Unit]
Description=Back up the Ember bridge database and secrets@LABEL@
After=@NAME@.service

[Service]
Type=oneshot
User=@NAME@
Group=@NAME@
UMask=0077
ExecStart=/usr/local/lib/@NAME@/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths=/var/lib/@NAME@ /var/backups/@NAME@
