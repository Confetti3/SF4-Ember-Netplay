# The Ember replay archive at https://@HOST@: the page from @WEBROOT@, the
# bridge's listing at /v1/archive (with the budgets and cache of
# conf.d/@ZONE@.conf), and the bucket's replay files at
# /@BUCKET@/. nginx keeps no access log here.

server {
    listen 80;
    listen [::]:80;
    server_name @HOST@;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @HOST@;

    ssl_certificate     /etc/ssl/certs/embernetplay.link.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/embernetplay.link.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log off;
    client_max_body_size 1k;
    limit_req_status 429;
    limit_conn_status 429;
@LOCATIONS@
}
