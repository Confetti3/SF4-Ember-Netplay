# Copy to .env and fill in.

# The relay's public name, as agreed with Katie. Ember builds pin this exact
# name, so it cannot change later without a new build.
RELAY_HOSTNAME=relay-eu.embernetplay.link

# The folder Nginx Proxy Manager keeps its certificates in on this machine:
# the host side of its "/etc/letsencrypt" volume (it has a "live" folder).
NPM_LETSENCRYPT_DIR=/opt/nginx-proxy-manager/letsencrypt

# Optional. The certificate folder under live/ (such as npm-12). Leave empty
# to use whichever valid certificate there is for RELAY_HOSTNAME.
RELAY_CERT_NAME=

# Optional. The plain HTTP port the proxy forwards to (default 47895).
#RELAY_HTTP_PORT=47895
