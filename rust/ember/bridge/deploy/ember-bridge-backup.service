[Unit]
Description=Back up the Ember bridge database and secrets
After=ember-bridge.service

[Service]
Type=oneshot
User=ember-bridge
Group=ember-bridge
UMask=0077
ExecStart=/usr/local/lib/ember-bridge/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths=/var/lib/ember-bridge /var/backups/ember-bridge
